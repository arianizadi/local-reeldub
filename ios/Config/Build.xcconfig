// Override both values in LocalSigning.xcconfig when building for your own device.
REELDUB_BUNDLE_ID = com.arianizadi.reeldub
#include? "LocalSigning.xcconfig"

INFOPLIST_PREPROCESS = YES
// Preserve literal https:// URLs in XML text.
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = $(inherited) -traditional
INFOPLIST_PREPROCESSOR_DEFINITIONS[config=Debug][sdk=iphonesimulator*] = $(inherited) REELDUB_DEBUG_SIMULATOR=1
